@@ -10,6 +10,33 @@ char prefApp[] = "moonchild_shell";
 
 }  // namespace
 
+#ifdef __amigaos__
+// AmigaOS: the game's data are in its drawer's Data drawer, the player's
+// files (high scores, options) in its User drawer. PROGDIR: is the drawer.
+static char *amigaPath(char *buffer, size_t size, const char *dir, const char *filename) {
+  if (!filename) {
+    return nullptr;
+  }
+  snprintf(buffer, size, "PROGDIR:%s/%s", dir, filename);
+  return buffer;
+}
+char *FullPath(char *filename) {
+  static char buffer[512];
+  return amigaPath(buffer, sizeof(buffer), "Data/moonchild", filename);
+}
+char *FullAudioPath(char *filename) {
+  static char buffer[512];
+  return amigaPath(buffer, sizeof(buffer), "Data/audio", filename);
+}
+char *FullMoviePath(char *filename) {
+  static char buffer[512];
+  return amigaPath(buffer, sizeof(buffer), "Data/movies", filename);
+}
+char *FullWritablePath(char *filename) {
+  static char buffer[512];
+  return amigaPath(buffer, sizeof(buffer), "User", filename);
+}
+#else
 // Called by the game to get the full path to a file
 char *FullPath(char *filename) {
   static char buffer[4096];
@@ -73,6 +100,8 @@ char *FullWritablePath(char *filename) {
   return buffer;
 }
 
+#endif  // __amigaos__
